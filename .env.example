DATABASE_URL=postgresql://user:password@host/database?sslmode=require
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Aurora Transfers <bookings@example.com>
BOOKING_TO_EMAIL=operations@example.com
PARTNER_FROM_EMAIL=Aurora Transfers <partners@example.com>
PARTNER_TO_EMAIL=operations@example.com
BUSINESS_FROM_EMAIL=Aurora Transfers <business@example.com>
BUSINESS_TO_EMAIL=operations@example.com
# Optional: connects /api/flight-status to Aviationstack. Without it, the UI uses clearly labelled demo data.
AVIATIONSTACK_API_KEY=
