---
import Header from "../components/Header.astro";
import { getContent, getInterfaceContent, languages, type Lang } from "../data/site";
import "../styles/global.css";

interface Props { lang: Lang; title: string; description: string; active?: string; }
const { lang, title, description, active = "home" } = Astro.props;
const t = getContent(lang);
const ui = getInterfaceContent(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const localized = (target: Lang) => Astro.url.pathname === "/" ? (target === "en" ? "/" : `/${target}/`) : Astro.url.pathname.replace(/^\/(hr|en|de|fr)(?=\/|$)/, `/${target}`);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {languages.map((target) => <link rel="alternate" hreflang={target} href={new URL(localized(target), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localized("en"), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aurora Private Transfers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/media/dubrovnik-harbor.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TaxiService",
      name: "Aurora Private Transfers",
      url: Astro.site,
      image: new URL("/media/dubrovnik-harbor.jpg", Astro.site),
      areaServed: ["Croatia", "Central Europe", "Austria", "Hungary", "Slovenia", "Germany"],
      availableLanguage: ["Croatian", "English", "German", "French"]
    })} />
  </head>
  <body>
    <Header lang={lang} active={active} />
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-wrap">
        <div class="footer-brand">
          <a class="wordmark footer-logo" href={lang === "en" && Astro.url.pathname === "/" ? "/" : `/${lang}/`}><img class="footer-brand-logo" src="/media/aurora-logo.svg" alt="Aurora Private Transfers" /></a>
          <div class="footer-socials">
            <a href="https://www.instagram.com/auroratransfers/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.4" cy="6.6" r="1"></circle></svg></a>
            <a href="https://www.facebook.com/auroratransfers/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v4h4v-4h3l1-4h-4V9c0-.6.4-1 1-1Z"></path></svg></a>
            <a href="https://wa.me/385000000000" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L3 20.7l1.5-4.6a8.5 8.5 0 1 1 16-4.3Z"></path><path d="M8.6 7.8c.3-.7.7-.7 1-.7h.5c.2 0 .4.1.5.4l.8 1.9c.1.3.1.5-.1.7l-.5.6c-.2.2-.2.4-.1.6.5.9 1.2 1.6 2.1 2.1.2.1.4.1.6-.1l.6-.5c.2-.2.4-.2.7-.1l1.9.8c.3.1.4.3.4.5v.5c0 .3 0 .7-.7 1-1 .5-2.6.3-4.6-.8-1.4-.8-2.6-2-3.4-3.4-1.1-2-.9-3.6-.4-4.6Z"></path></svg></a>
          </div>
        </div>
        <nav class="footer-menu" aria-label="Aurora navigation"><a href={`/${lang}/services/`}>{t.nav.services}</a><a href={`/${lang}/routes/`}>{t.nav.routes}</a><a href={`/${lang}/business/`}>{t.nav.business}</a><a href={`/${lang}/concierge/`}>{t.nav.concierge}</a><a href={`/${lang}/help/`}>{t.nav.help}</a><a href={`/${lang}/work-with-us/`}>{t.nav["work-with-us"]}</a><a href={`/${lang}/contact/`}>{t.nav.contact}</a><a href={`/${lang}/book/`}>{t.nav.book}</a></nav>
        <div class="footer-info"><p>{t.footer}</p><a href="tel:+385000000000">+385 00 000 0000</a><a href="mailto:booking@auroratransfers.com">booking@auroratransfers.com</a></div>
      </div>
      <div class="footer-bottom">© {new Date().getFullYear()} Aurora Private Transfers · {ui.country}</div>
    </footer>
    <script>
      const menuButton = document.querySelector("[data-menu-toggle]");
      const mobileMenu = document.querySelector("[data-mobile-menu]");
      const closeMobileMenu = () => {
        mobileMenu?.setAttribute("hidden", "");
        menuButton?.classList.remove("open");
        menuButton?.setAttribute("aria-expanded", "false");
      };
      menuButton?.addEventListener("click", () => {
        const open = mobileMenu?.hasAttribute("hidden") ?? true;
        mobileMenu?.toggleAttribute("hidden", !open);
        menuButton.classList.toggle("open", open);
        menuButton.setAttribute("aria-expanded", String(open));
      });
      mobileMenu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMobileMenu));
      const language = document.querySelector("[data-language]");
      const languageButton = language?.querySelector("button");
      const languageMenu = language?.querySelector(".language-menu");
      const scrollParam = new URLSearchParams(window.location.search).get("_scroll");
      const savedScroll = Number(scrollParam);
      if (scrollParam !== null && Number.isFinite(savedScroll)) {
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
        history.replaceState(history.state, "", `${window.location.pathname}${window.location.hash}`);
        document.documentElement.classList.add("language-switching");
        const restoreScroll = () => window.scrollTo(0, savedScroll);
        requestAnimationFrame(() => requestAnimationFrame(restoreScroll));
        [50, 200, 500, 900, 1400].forEach((delay) => setTimeout(restoreScroll, delay));
        setTimeout(() => document.documentElement.classList.remove("language-switching"), 1500);
      }
      const prepareLanguageLinks = () => {
        languageMenu?.querySelectorAll("a").forEach((link) => {
          const target = new URL(link.href);
          target.searchParams.set("_scroll", String(Math.round(window.scrollY)));
          link.href = target.toString();
        });
      };
      const setLanguageMenu = (open) => {
        languageMenu?.toggleAttribute("hidden", !open);
        languageButton?.setAttribute("aria-expanded", String(open));
      };
      const desktopLanguageMenu = window.matchMedia("(min-width: 980px)");
      languageButton?.addEventListener("click", (event) => {
        event.stopPropagation();
        prepareLanguageLinks();
        const open = languageMenu?.hasAttribute("hidden") ?? true;
        setLanguageMenu(desktopLanguageMenu.matches ? true : open);
      });
      language?.addEventListener("mouseenter", () => {
        if (!desktopLanguageMenu.matches) return;
        prepareLanguageLinks();
        setLanguageMenu(true);
      });
      language?.addEventListener("mouseleave", () => {
        if (desktopLanguageMenu.matches) setLanguageMenu(false);
      });
      language?.addEventListener("focusin", () => {
        if (!desktopLanguageMenu.matches) return;
        prepareLanguageLinks();
        setLanguageMenu(true);
      });
      language?.addEventListener("focusout", () => {
        if (!desktopLanguageMenu.matches) return;
        requestAnimationFrame(() => {
          if (!language?.contains(document.activeElement)) setLanguageMenu(false);
        });
      });
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !mobileMenu?.contains(event.target) && !menuButton?.contains(event.target)) closeMobileMenu();
        if (event.target instanceof Node && !language?.contains(event.target)) {
          setLanguageMenu(false);
        }
      });
    </script>
  </body>
</html>
