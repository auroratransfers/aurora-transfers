---
import { Search } from "@lucide/astro";
import { getLabels, locations, routePrices, type Lang } from "../data/site";
interface Props { lang: Lang; compact?: boolean; }
const { lang } = Astro.props;
const t = getLabels(lang).booking;
const locationLabels: Record<Lang, Record<string, string>> = {
  hr: { airport: "Zračna luka Dubrovnik", dubrovnik: "Dubrovnik – Stari grad", hotel: "Dubrovnik – hotel / vila", split: "Split", mostar: "Mostar", kotor: "Kotor" },
  en: { airport: "Dubrovnik Airport", dubrovnik: "Dubrovnik – Old Town", hotel: "Dubrovnik – hotel / villa", split: "Split", mostar: "Mostar", kotor: "Kotor" },
  de: { airport: "Flughafen Dubrovnik", dubrovnik: "Dubrovnik – Altstadt", hotel: "Dubrovnik – Hotel / Villa", split: "Split", mostar: "Mostar", kotor: "Kotor" },
  fr: { airport: "Aéroport de Dubrovnik", dubrovnik: "Dubrovnik – Vieille ville", hotel: "Dubrovnik – hôtel / villa", split: "Split", mostar: "Mostar", kotor: "Kotor" },
};
---
<div class="booking-panel" data-booking>
  <div class="booking-heading">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>
    <p>{t.text}</p>
  </div>
  <form class="booking-form" action={`/${lang}/booking`} method="get">
    <div class="field">
      <label for={`pickup-${lang}`}>{t.pickup}</label>
      <select id={`pickup-${lang}`} name="pickup" required data-pickup>
        <option value="">{t.placeholder}</option>
        {locations.map(([value]) => <option value={value}>{locationLabels[lang][value]}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`dropoff-${lang}`}>{t.dropoff}</label>
      <select id={`dropoff-${lang}`} name="dropoff" required data-dropoff>
        <option value="">{t.placeholder}</option>
        {locations.map(([value]) => <option value={value}>{locationLabels[lang][value]}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`date-${lang}`}>{t.date}</label>
      <input id={`date-${lang}`} type="date" name="date" required data-date />
    </div>
    <div class="field">
      <label for={`passengers-${lang}`}>{t.passengers}</label>
      <select id={`passengers-${lang}`} name="passengers">
        {[1,2,3,4,5,6,7,8].map((count) => <option value={count}>{count}{count === 8 ? "+" : ""}</option>)}
      </select>
    </div>
    <div class="field contact-field">
      <label for={`contact-${lang}`}>{t.contact}</label>
      <input id={`contact-${lang}`} name="contact" autocomplete="email" placeholder="+385 / email@example.com" />
    </div>
    <div class="price-output" data-price-output aria-live="polite">
      <span><small>{t.result}</small><strong data-price-value>35 €</strong></span><small>{t.note}</small>
    </div>
    <button class="button button-purple booking-submit" type="submit">{t.submit}<Search size={17} /></button>
  </form>
</div>

<script define:vars={{ prices: routePrices }}>
  document.querySelectorAll("[data-booking]").forEach((booking) => {
    const pickup = booking.querySelector("[data-pickup]");
    const dropoff = booking.querySelector("[data-dropoff]");
    const output = booking.querySelector("[data-price-output]");
    const value = booking.querySelector("[data-price-value]");
    const date = booking.querySelector("[data-date]");
    if (date instanceof HTMLInputElement) date.min = new Date().toISOString().slice(0, 10);
    const update = () => {
      if (!(pickup instanceof HTMLSelectElement) || !(dropoff instanceof HTMLSelectElement)) return;
      const price = prices[`${pickup.value}-${dropoff.value}`];
      output?.classList.toggle("visible", Boolean(price));
      if (price && value) value.textContent = `${price} €`;
    };
    pickup?.addEventListener("change", update);
    dropoff?.addEventListener("change", update);
  });
</script>
