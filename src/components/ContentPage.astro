---
import { ArrowRight, Car, Check, Compass, MapPin, Plane, ShieldCheck } from "@lucide/astro";
import { getContent, getInterfaceContent, type Lang, type Page } from "../data/site";
import { getMarketingPageContent, isMarketingPage } from "../data/pageCopy";

interface Props { lang: Lang; page: Page; }
const { lang, page } = Astro.props;
const t = getContent(lang);
const ui = getInterfaceContent(lang);
const marketingContent = isMarketingPage(page) ? getMarketingPageContent(lang, page) : null;
const cardIcons = [Plane, Car, MapPin, Compass];
const fleetVehicleImageAlt = {
  hr: "Aurora premium vozilo za privatne transfere",
  en: "Aurora premium vehicle for private transfers",
  de: "Aurora Premiumfahrzeug für Privattransfers",
  fr: "Véhicule premium Aurora pour les transferts privés",
}[lang];
---

<section class="content-page soft-page">
  {marketingContent ? <>
    <span class="section-marker pink-marker">{marketingContent.tag}</span>
    <h1>{marketingContent.title}</h1>
    <p class="page-intro">{marketingContent.intro}</p>
    <div class="content-page-actions">
      <a class="pill-button primary" href={`/${lang}/book/`}>{marketingContent.primaryCta}<ArrowRight size={16} /></a>
      <a class="pill-button outline" href={`/${lang}/${marketingContent.secondaryHref}/`}>{marketingContent.secondaryCta}<ArrowRight size={16} /></a>
    </div>

    <div class="content-card-grid">
      {marketingContent.cards.map((card, index) => {
        const Icon = cardIcons[index] || Compass;
        return <article class:list={[{ "fleet-content-card": page === "fleet" }]}>
          {page === "fleet" && <div class="fleet-image"><img src="/media/fast-ride-van.png" alt={fleetVehicleImageAlt} loading="lazy" /></div>}
          {page !== "fleet" && <span><Icon size={23} /></span>}<h2>{card.title}</h2><p>{card.text}</p><a href={`/${lang}/book/`}>{card.cta}<ArrowRight size={14} /></a>
        </article>;
      })}
    </div>

    <section class:list={["content-detail", { "content-detail-image": page === "about" }]}>
      {page === "about" && <img src="/media/dubrovnik-harbor.jpg" alt={ui.imageAltHarbor} loading="lazy" />}
      <div class="content-detail-copy">
        <span class="section-marker kiwi-marker">{marketingContent.detail.tag}</span>
        <h2>{marketingContent.detail.title}</h2>
        {marketingContent.detail.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <ul>{marketingContent.detail.points.map((point) => <li><Check size={16} />{point}</li>)}</ul>
        <a class="pill-button primary" href={`/${lang}/book/`}>{marketingContent.detail.cta}<ArrowRight size={16} /></a>
      </div>
    </section>

    <div class="page-cta">
      <div><h2>{marketingContent.final.title}</h2><p>{marketingContent.final.text}</p></div>
      <div class="page-cta-actions">
        <a class="pill-button kiwi" href={`/${lang}/book/`}>{marketingContent.final.primaryCta}<ArrowRight size={16} /></a>
        <a class="pill-button light" href={`/${lang}/${marketingContent.final.secondaryHref}/`}>{marketingContent.final.secondaryCta}<ArrowRight size={16} /></a>
      </div>
    </div>
  </> : <>
    <span class="section-marker pink-marker">{t.nav.contact}</span><h1>{ui.pages.contactTitle}</h1><p class="page-intro">{ui.pages.contactIntro}</p>
    <div class="contact-page-grid"><div class="contact-panel purple-grid"><ShieldCheck size={29} /><h2>Aurora Private Transfers</h2><p>Dubrovnik, {ui.country}</p><a href="tel:+385000000000">+385 00 000 0000</a><a href="mailto:booking@auroratransfers.com">booking@auroratransfers.com</a></div><form class="simple-form"><label>{ui.pages.name}<input name="name" required /></label><label>{ui.pages.email}<input name="email" type="email" required /></label><label>{ui.pages.route}<input name="route" required /></label><label>{ui.pages.message}<textarea name="message" rows="4"></textarea></label><button class="pill-button primary" type="submit">{t.cta.button}<ArrowRight size={16} /></button></form></div>
    <div class="page-cta"><div><h2>{t.cta.title}</h2><p>{t.cta.text}</p></div><a class="pill-button kiwi" href={`/${lang}/book/`}>{t.cta.button}<ArrowRight size={16} /></a></div>
  </>}
</section>
