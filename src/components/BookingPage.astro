---
import { CalendarDays, CarFront, Check, ChevronDown, ChevronLeft, ChevronRight, MapPin, Plane, Route, Search, Ship, Users } from "@lucide/astro";
import { getContent, type Lang } from "../data/site";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getContent(lang).booking;
const icons = [Plane, Route, Ship, CarFront];
const help = {
  hr: ["Niste sigurni koji transfer odabrati?", "Pošaljite rutu koja vam odgovara. Prije potvrde provjerit ćemo vrijeme, granice i potrebnu veličinu vozila."],
  en: ["Not sure which transfer to choose?", "Send the route that suits you best. We will check timing, borders and vehicle size before confirmation."],
  de: ["Nicht sicher, welcher Transfer passt?", "Senden Sie Ihre Wunschroute. Wir prüfen Zeitplan, Grenzübertritte und die passende Fahrzeuggröße."],
  fr: ["Vous hésitez sur le transfert?", "Envoyez l'itinéraire souhaité. Nous vérifierons les horaires, les frontières et la taille du véhicule."]
}[lang];
---
<section class="booking-page soft-page" data-transfer-booking data-lang={lang}>
  <span class="section-marker pink-marker">{t.tag}</span>
  <h1>{t.title}</h1>
  <p class="page-intro">{t.intro}</p>

  <div class="booking-layout">
    <div class="service-column">
      <h2>{t.choose}</h2>
      <div class="service-options">
        {t.services.map((service, index) => { const Icon = icons[index]; return <button type="button" class="service-option" data-service-option={service[0]} data-service-label={service[1]}><span><Icon size={21} /></span><div><strong>{service[1]}</strong><small>{service[2]}</small></div><i><Check size={15} /></i></button>; })}
      </div>
      <div class="booking-help purple-grid"><CarFront size={28} /><h3>{help[0]}</h3><p>{help[1]}</p></div>
    </div>

    <div class="booking-card">
      <h2>{t.details}</h2>
      <form class="booking-form" action="/api/book" method="post">
        <div class="form-field full custom-select" data-service-select>
          <label>{t.selected}</label>
          <input type="hidden" name="service" required data-service-input />
          <button type="button" class="select-trigger" data-select-trigger aria-expanded="false"><span data-select-label>{t.selected}...</span><ChevronDown size={16} /></button>
          <div class="select-menu" data-select-menu hidden>{t.services.map((service) => <button type="button" data-select-value={service[0]} data-select-text={service[1]}>{service[1]}</button>)}</div>
        </div>
        <div class="form-field"><label for={`pickup-${lang}`}>{t.pickup}</label><div class="input-wrap"><MapPin size={16} /><input id={`pickup-${lang}`} name="pickup" required placeholder="Dubrovnik Airport" /></div></div>
        <div class="form-field"><label for={`destination-${lang}`}>{t.destination}</label><div class="input-wrap"><MapPin size={16} /><input id={`destination-${lang}`} name="destination" required placeholder="Hotel / city / marina" /></div></div>
        <div class="form-field"><label for={`name-${lang}`}>{t.name}</label><input id={`name-${lang}`} name="name" autocomplete="name" required /></div>
        <div class="form-field"><label for={`email-${lang}`}>{t.email}</label><input id={`email-${lang}`} name="email" type="email" autocomplete="email" required /></div>
        <div class="form-field"><label for={`phone-${lang}`}>{t.phone}</label><input id={`phone-${lang}`} name="phone" type="tel" autocomplete="tel" required placeholder="+385 ..." /></div>
        <div class="form-field custom-select" data-passenger-select>
          <label>{t.passengers}</label><input type="hidden" name="passengers" value="1" />
          <button type="button" class="select-trigger" data-select-trigger aria-expanded="false"><span data-select-label>1</span><Users size={16} /><ChevronDown size={16} /></button>
          <div class="select-menu compact-menu" data-select-menu hidden>{[1,2,3,4,5,6,7,8].map((number) => <button type="button" data-select-value={number} data-select-text={`${number}${number === 8 ? "+" : ""}`}>{number}{number === 8 ? "+" : ""}</button>)}</div>
        </div>
        <div class="form-field full">
          <label>{t.date}</label>
          <div class="calendar-box">
            <div class="calendar-header"><button type="button" data-cal-prev aria-label="Previous month"><ChevronLeft size={18} /></button><strong data-cal-title></strong><button type="button" data-cal-next aria-label="Next month"><ChevronRight size={18} /></button></div>
            <div class="calendar-weekdays" data-cal-weekdays></div>
            <div class="calendar-days" data-cal-days></div>
          </div>
          <input type="hidden" name="date" required data-date-input />
          <p class="date-choice" data-date-choice></p>
        </div>
        <div class="form-field"><label for={`flight-${lang}`}>{t.flight}</label><div class="input-wrap"><Plane size={16} /><input id={`flight-${lang}`} name="flight" /></div></div>
        <div class="form-field"><label for={`message-${lang}`}>{t.message}</label><input id={`message-${lang}`} name="message" /></div>
        <button class="pill-button primary submit-button full" type="submit"><CalendarDays size={17} />{t.submit}</button>
      </form>
      <div class="booking-success" data-booking-success hidden><span><Check size={23} /></span><h3>Request received</h3><p>We will review your route and contact you with availability and the confirmed price.</p><button type="button" data-booking-again>Make another request</button></div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-transfer-booking]").forEach((booking) => {
    const serviceInput = booking.querySelector("[data-service-input]");
    const serviceLabel = booking.querySelector("[data-service-select] [data-select-label]");
    const serviceMenu = booking.querySelector("[data-service-select] [data-select-menu]");
    const setService = (value, label) => {
      if (serviceInput instanceof HTMLInputElement) serviceInput.value = value;
      if (serviceLabel) serviceLabel.textContent = label;
      booking.querySelector("[data-service-select] [data-select-trigger]")?.classList.remove("invalid");
      booking.querySelectorAll("[data-service-option]").forEach((option) => option.classList.toggle("selected", option.getAttribute("data-service-option") === value));
      if (serviceMenu) serviceMenu.hidden = true;
    };
    booking.querySelectorAll("[data-service-option]").forEach((option) => option.addEventListener("click", () => setService(option.getAttribute("data-service-option") || "", option.getAttribute("data-service-label") || "")));

    booking.querySelectorAll(".custom-select").forEach((select) => {
      const trigger = select.querySelector("[data-select-trigger]");
      const menu = select.querySelector("[data-select-menu]");
      const label = select.querySelector("[data-select-label]");
      const input = select.querySelector('input[type="hidden"]');
      trigger?.addEventListener("click", () => {
        booking.querySelectorAll("[data-select-menu]").forEach((other) => { if (other !== menu) other.hidden = true; });
        const open = menu?.hasAttribute("hidden") ?? true;
        if (menu) menu.hidden = !open;
        trigger.setAttribute("aria-expanded", String(open));
      });
      menu?.querySelectorAll("[data-select-value]").forEach((option) => option.addEventListener("click", () => {
        const value = option.getAttribute("data-select-value") || "";
        const text = option.getAttribute("data-select-text") || "";
        if (select.hasAttribute("data-service-select")) setService(value, text);
        else { if (input instanceof HTMLInputElement) input.value = value; if (label) label.textContent = text; if (menu) menu.hidden = true; }
        trigger?.setAttribute("aria-expanded", "false");
      }));
    });

    const locale = booking.getAttribute("data-lang") || "en";
    const title = booking.querySelector("[data-cal-title]");
    const weekdays = booking.querySelector("[data-cal-weekdays]");
    const days = booking.querySelector("[data-cal-days]");
    const dateInput = booking.querySelector("[data-date-input]");
    const dateChoice = booking.querySelector("[data-date-choice]");
    const today = new Date(); today.setHours(0, 0, 0, 0);
    let currentMonth = new Date(today.getFullYear(), today.getMonth(), 1);
    let selected = "";
    const monday = new Date(2024, 0, 1);
    if (weekdays) weekdays.innerHTML = Array.from({ length: 7 }, (_, index) => { const date = new Date(monday); date.setDate(monday.getDate() + index); return `<span>${new Intl.DateTimeFormat(locale, { weekday: "short" }).format(date).slice(0, 2)}</span>`; }).join("");
    const render = () => {
      if (!title || !days) return;
      title.textContent = new Intl.DateTimeFormat(locale, { month: "long", year: "numeric" }).format(currentMonth);
      const offset = (currentMonth.getDay() + 6) % 7;
      const count = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 0).getDate();
      days.innerHTML = `${'<span></span>'.repeat(offset)}${Array.from({ length: count }, (_, index) => {
        const n = index + 1; const date = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), n);
        const iso = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(n).padStart(2, "0")}`;
        return `<button type="button" data-day="${iso}" ${date < today ? "disabled" : ""} class="${selected === iso ? "selected" : ""}">${n}</button>`;
      }).join("")}`;
      days.querySelectorAll("[data-day]").forEach((button) => button.addEventListener("click", () => {
        selected = button.getAttribute("data-day") || "";
        if (dateInput instanceof HTMLInputElement) dateInput.value = selected;
        booking.querySelector(".calendar-box")?.classList.remove("invalid");
        if (dateChoice && selected) dateChoice.textContent = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" }).format(new Date(`${selected}T12:00:00`));
        render();
      }));
    };
    booking.querySelector("[data-cal-prev]")?.addEventListener("click", () => { const prev = new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1, 1); if (prev >= new Date(today.getFullYear(), today.getMonth(), 1)) currentMonth = prev; render(); });
    booking.querySelector("[data-cal-next]")?.addEventListener("click", () => { currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1); render(); });
    render();
    const form = booking.querySelector(".booking-form");
    const success = booking.querySelector("[data-booking-success]");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
      if (!(serviceInput instanceof HTMLInputElement) || !serviceInput.value) {
        booking.querySelector("[data-service-select] [data-select-trigger]")?.classList.add("invalid");
        booking.querySelector("[data-service-select] [data-select-trigger]")?.focus();
        return;
      }
      if (!(dateInput instanceof HTMLInputElement) || !dateInput.value) {
        booking.querySelector(".calendar-box")?.classList.add("invalid");
        return;
      }
      const payload = Object.fromEntries(new FormData(form).entries());
      try { await fetch("/api/book", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) }); } catch (_) {}
      form.hidden = true;
      if (success) success.hidden = false;
    });
    booking.querySelector("[data-booking-again]")?.addEventListener("click", () => {
      if (form instanceof HTMLFormElement) form.reset();
      if (form) form.hidden = false;
      if (success) success.hidden = true;
    });
    document.addEventListener("click", (event) => { if (event.target instanceof Node && !booking.contains(event.target)) booking.querySelectorAll("[data-select-menu]").forEach((menu) => menu.hidden = true); });
  });
</script>
