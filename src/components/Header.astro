---
import { CalendarCheck, Car, Globe2, Menu, Phone, X } from "@lucide/astro";
import { getContent, languages, type Lang } from "../data/site";

interface Props { lang: Lang; active?: string; }
const { lang, active = "home" } = Astro.props;
const t = getContent(lang);
const currentPath = Astro.url.pathname;
const langPath = (target: Lang) => currentPath.replace(/^\/(hr|en|de|fr)(?=\/|$)/, `/${target}`);
const bookingLabel = { hr: "Rezerviraj transfer", en: "Book Transfer", de: "Transfer buchen", fr: "Réserver transfert" }[lang];
const links = [
  ["home", `/${lang}/`, t.nav.home],
  ["services", `/${lang}/services/`, t.nav.services],
  ["destinations", `/${lang}/destinations/`, t.nav.destinations],
  ["fleet", `/${lang}/fleet/`, t.nav.fleet],
  ["about", `/${lang}/about/`, t.nav.about],
  ["contact", `/${lang}/contact/`, t.nav.contact]
] as const;
---
<header class="site-header" data-header>
  <nav class="nav-wrap">
    <a class="wordmark" href={`/${lang}/`} aria-label="Feniks Dubrovnik Transfers home">
      <span class="logo-symbol"><Car size={22} strokeWidth={2.4} /></span>
      <span>Feniks<small>Dubrovnik Transfers</small></span>
    </a>
    <div class="desktop-nav" aria-label="Main navigation">
      {links.map(([key, href, label]) => <a class:list={["nav-link", { active: active === key }]} href={href}>{label}</a>)}
    </div>
    <div class="nav-tools">
      <div class="language-control" data-language>
        <button class="round-tool language-trigger" type="button" aria-label="Change language" aria-expanded="false"><Globe2 size={15} /><span>{lang.toUpperCase()}</span></button>
        <div class="language-menu" hidden>
          {languages.map((target) => <a class:list={[{ active: target === lang }]} href={langPath(target)}>{target.toUpperCase()}</a>)}
        </div>
      </div>
      <a class="round-tool phone-tool" href="tel:+385000000000" aria-label="Call Feniks Transfers"><Phone size={16} /></a>
      <a class:list={["nav-book-button", { active: active === "book" }]} href={`/${lang}/book/`} aria-label={bookingLabel}><CalendarCheck size={16} /><span>{bookingLabel}</span></a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false"><Menu class="menu-open-icon" size={21} /><X class="menu-close-icon" size={21} /></button>
    </div>
  </nav>
  <div class="mobile-menu" data-mobile-menu hidden>
    {links.map(([key, href, label]) => <a class:list={[{ active: active === key }]} href={href}>{label}</a>)}
  </div>
</header>
