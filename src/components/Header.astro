---
import { Menu, Phone, X } from "@lucide/astro";
import { getContent, getInterfaceContent, languages, type Lang } from "../data/site";

interface Props { lang: Lang; active?: string; }
const { lang, active = "home" } = Astro.props;
const t = getContent(lang);
const ui = getInterfaceContent(lang);
const currentPath = Astro.url.pathname;
const isDefaultHome = currentPath === "/";
const langPath = (target: Lang) => isDefaultHome ? (target === "en" ? "/" : `/${target}/`) : currentPath.replace(/^\/(hr|en|de|fr)(?=\/|$)/, `/${target}`);
const homePath = lang === "en" && isDefaultHome ? "/" : `/${lang}/`;
const bookingLabel = { hr: "Rezerviraj transfer", en: "Book transfer", de: "Transfer buchen", fr: "Réserver un transfert" }[lang];
const links = [
  ["home", homePath, t.nav.home],
  ["services", `/${lang}/services/`, t.nav.services],
  ["destinations", `/${lang}/destinations/`, t.nav.destinations],
  ["fleet", `/${lang}/fleet/`, t.nav.fleet],
  ["about", `/${lang}/about/`, t.nav.about],
  ["contact", `/${lang}/contact/`, t.nav.contact]
] as const;
---
<header class="site-header" data-header>
  <nav class="nav-wrap">
    <a class="wordmark header-wordmark" href={homePath} aria-label={ui.homeLabel}>
      <span>Aurora<small>Dubrovnik Transfers</small></span>
    </a>
    <div class="desktop-nav" aria-label={ui.mainNavigation}>
      {links.map(([key, href, label]) => <a class:list={["nav-link", { active: active === key }]} href={href}>{label}</a>)}
    </div>
    <div class="nav-tools">
      <div class="language-control" data-language>
        <button class="round-tool language-trigger" type="button" aria-label={ui.changeLanguage} aria-expanded="false"><span>{lang.toUpperCase()}</span></button>
        <div class="language-menu" hidden>
          {languages.map((target) => <a class:list={[{ active: target === lang }]} href={langPath(target)}>{target.toUpperCase()}</a>)}
        </div>
      </div>
      <a class="round-tool phone-tool" href="tel:+385000000000" aria-label={ui.call}><Phone size={16} /></a>
      <a class:list={["nav-book-button", { active: active === "book" }]} href={`/${lang}/book/`} aria-label={bookingLabel}><span class="book-label-mobile">{t.nav.book}</span><span class="book-label-desktop">{bookingLabel}</span></a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label={ui.openMenu} aria-expanded="false"><Menu class="menu-open-icon" size={21} /><X class="menu-close-icon" size={21} /></button>
    </div>
  </nav>
  <div class="mobile-menu" data-mobile-menu hidden>
    {links.map(([key, href, label]) => <a class:list={[{ active: active === key }]} href={href}>{label}</a>)}
  </div>
</header>
