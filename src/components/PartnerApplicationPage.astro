---
import { ArrowRight, BadgeCheck, BriefcaseBusiness, CarFront, Check, FileText, Globe2, ImagePlus, MapPinned, ShieldCheck, Upload, UserRound, UsersRound } from "@lucide/astro";
import { getPartnerApplicationContent } from "../data/partnerApplication";
import type { Lang } from "../data/site";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const p = getPartnerApplicationContent(lang);
---

<section
  class="partner-page soft-page"
  data-partner-application
  data-photo-limit={p.photoLimit}
  data-photo-required={p.photoRequired}
  data-photo-size={p.photoSize}
  data-upload-error={p.uploadError}
  data-generic-error={p.genericError}
  data-preparing-photos={p.preparingPhotos}
  data-sending={p.sending}
>
  <div class="partner-application-grid">
    <aside class="partner-intro-panel">
      <span class="section-marker kiwi-marker"><BadgeCheck size={15} />{p.tag}</span>
      <h1>{p.title}</h1>
      <p class="partner-statement">{p.statement}</p>
      <p>{p.intro}</p>
      <img src="/media/dubrovnik-harbor.jpg" alt={p.imageAlt} loading="eager" />
      <div class="partner-benefits">
        <span class="section-marker pink-marker">{p.benefitsTag}</span>
        <h2>{p.benefitsTitle}</h2>
        <p>{p.benefitsText}</p>
        <ul>
          {p.benefits.map((benefit) => <li><Check size={16} />{benefit}</li>)}
        </ul>
      </div>
    </aside>

    <div class="partner-form-surface">
      <header class="partner-form-heading">
        <span><BriefcaseBusiness size={20} /></span>
        <div>
          <small>{p.formTag}</small>
          <h2>{p.formTitle}</h2>
          <p>{p.formIntro}</p>
        </div>
      </header>

      <form class="partner-form" data-partner-form autocomplete="on">
        <input type="hidden" name="language" value={lang} />

        <fieldset class="partner-section">
          <legend>{p.applicantType}</legend>
          <div class="partner-choice-grid partner-applicant-types">
            <label class="partner-choice-card">
              <input type="radio" name="applicantType" value="independent-driver" checked required />
              <span class="partner-choice-icon"><UserRound size={19} /></span>
              <span><strong>{p.individualDriver}</strong><small>{p.individualDriverText}</small></span>
            </label>
            <label class="partner-choice-card">
              <input type="radio" name="applicantType" value="transport-company" required />
              <span class="partner-choice-icon"><BriefcaseBusiness size={19} /></span>
              <span><strong>{p.transportCompany}</strong><small>{p.transportCompanyText}</small></span>
            </label>
          </div>
        </fieldset>

        <fieldset class="partner-section">
          <legend><UserRound size={18} />{p.sections.profile}</legend>
          <div class="partner-fields">
            <label class="partner-field"><span>{p.fields.fullName}</span><input name="fullName" autocomplete="name" required /></label>
            <label class="partner-field" data-company-field><span>{p.fields.companyName}</span><input name="companyName" autocomplete="organization" /></label>
            <label class="partner-field"><span>{p.fields.email}</span><input name="email" type="email" autocomplete="email" required /></label>
            <label class="partner-field"><span>{p.fields.phone}</span><input name="phone" type="tel" autocomplete="tel" required /></label>
            <label class="partner-field"><span>{p.fields.country}</span><input name="country" autocomplete="country-name" required /></label>
            <label class="partner-field"><span>{p.fields.baseCity}</span><input name="baseCity" autocomplete="address-level2" required /></label>
          </div>
        </fieldset>

        <fieldset class="partner-section">
          <legend><ShieldCheck size={18} />{p.sections.qualifications}</legend>
          <div class="partner-fields">
            <label class="partner-field"><span>{p.fields.yearsExperience}</span><input name="yearsExperience" type="number" min="0" max="60" inputmode="numeric" required /></label>
            <label class="partner-field"><span>{p.fields.licenseNumber}</span><input name="licenseNumber" required /></label>
            <label class="partner-field"><span>{p.fields.transportPermit}</span><input name="transportPermit" required /></label>
            <label class="partner-field"><span>{p.fields.insuranceValidUntil}</span><input name="insuranceValidUntil" type="date" required /></label>
          </div>
          <div class="partner-option-group">
            <span>{p.languageLabel}</span>
            <div class="partner-check-grid">
              {p.languages.map(([value, label]) => <label><input type="checkbox" name="languages" value={value} /><span>{label}</span></label>)}
            </div>
          </div>
          <label class="partner-field partner-field-full"><span>{p.fields.otherLanguages}</span><input name="otherLanguages" /></label>
          <div class="partner-option-group">
            <span>{p.availabilityLabel}</span>
            <div class="partner-check-grid">
              {p.availability.map(([value, label]) => <label><input type="checkbox" name="availability" value={value} /><span>{label}</span></label>)}
            </div>
          </div>
        </fieldset>

        <fieldset class="partner-section">
          <legend><CarFront size={18} />{p.sections.vehicle}</legend>
          <div class="partner-fields">
            <label class="partner-field"><span>{p.fields.vehicleMake}</span><input name="vehicleMake" required /></label>
            <label class="partner-field"><span>{p.fields.vehicleModel}</span><input name="vehicleModel" required /></label>
            <label class="partner-field"><span>{p.fields.vehicleYear}</span><input name="vehicleYear" type="number" min="1995" max="2027" inputmode="numeric" required /></label>
            <label class="partner-field"><span>{p.fields.plateNumber}</span><input name="plateNumber" autocapitalize="characters" required /></label>
            <label class="partner-field"><span>{p.fields.vehicleColor}</span><input name="vehicleColor" required /></label>
            <label class="partner-field"><span>{p.fields.seats}</span><input name="seats" type="number" min="1" max="60" inputmode="numeric" required /></label>
            <label class="partner-field"><span>{p.fields.luggageCapacity}</span><input name="luggageCapacity" type="number" min="0" max="40" inputmode="numeric" required /></label>
          </div>
          <div class="partner-option-group">
            <span>{p.vehicleTypeLabel}</span>
            <div class="partner-check-grid">
              {p.vehicleTypes.map(([value, label]) => <label><input type="radio" name="vehicleType" value={value} required /><span>{label}</span></label>)}
            </div>
          </div>
          <div class="partner-option-group">
            <span>{p.amenitiesLabel}</span>
            <div class="partner-check-grid">
              {p.amenities.map(([value, label]) => <label><input type="checkbox" name="amenities" value={value} /><span>{label}</span></label>)}
            </div>
          </div>
        </fieldset>

        <fieldset class="partner-section">
          <legend><MapPinned size={18} />{p.sections.coverage}</legend>
          <div class="partner-fields">
            <label class="partner-field"><span>{p.fields.serviceBase}</span><input name="serviceBase" required /></label>
            <label class="partner-field"><span>{p.fields.coverageCountries}</span><input name="coverageCountries" required /></label>
          </div>
          <label class="partner-field partner-field-full"><span>{p.fields.usualRoutes}</span><textarea name="usualRoutes" rows="4" required></textarea></label>
        </fieldset>

        <fieldset class="partner-section">
          <legend><ImagePlus size={18} />{p.sections.photos}</legend>
          <div class="partner-photo-upload">
            <input class="partner-photo-input" id="partner-photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple data-partner-photos />
            <label class="partner-photo-control" for="partner-photos">
              <span><Upload size={21} /></span>
              <strong>{p.photoLabel}</strong>
              <small>{p.photoText}</small>
              <b>{p.choosePhotos}</b>
            </label>
            <p class="partner-photo-empty" data-partner-photo-empty>{p.noPhotos}</p>
            <ul class="partner-photo-list" data-partner-photo-list></ul>
          </div>
        </fieldset>

        <fieldset class="partner-section partner-final-section">
          <legend><FileText size={18} />{p.sections.final}</legend>
          <label class="partner-field partner-field-full"><span>{p.fields.notes}</span><textarea name="notes" rows="4"></textarea></label>
          <label class="partner-agreement"><input name="agreement" type="checkbox" required /><span>{p.agreement}</span></label>
        </fieldset>

        <p class="partner-form-error" data-partner-error role="alert" hidden></p>
        <div class="partner-form-action">
          <button class="pill-button primary" type="submit" data-partner-submit>{p.submit}<ArrowRight size={17} /></button>
        </div>
      </form>

      <div class="partner-success" data-partner-success hidden>
        <span><Check size={24} /></span>
        <h2>{p.successTitle}</h2>
        <p>{p.successText}</p>
        <strong data-partner-reference hidden><small>{p.referenceLabel}</small><b></b></strong>
        <button class="pill-button outline" type="button" data-partner-again>{p.applyAgain}<ArrowRight size={16} /></button>
      </div>
    </div>
  </div>
</section>

<script>
  const application = document.querySelector("[data-partner-application]");

  if (application instanceof HTMLElement) {
    const form = application.querySelector("[data-partner-form]");
    const photoInput = application.querySelector("[data-partner-photos]");
    const photoList = application.querySelector("[data-partner-photo-list]");
    const photoEmpty = application.querySelector("[data-partner-photo-empty]");
    const error = application.querySelector("[data-partner-error]");
    const submit = application.querySelector("[data-partner-submit]");
    const success = application.querySelector("[data-partner-success]");
    const reference = application.querySelector("[data-partner-reference]");
    const companyInput = application.querySelector('input[name="companyName"]');
    const companyField = application.querySelector("[data-company-field]");
    const defaultSubmitLabel = submit?.textContent || "";
    const copy = application.dataset;

    const selectedFiles = () => photoInput instanceof HTMLInputElement ? Array.from(photoInput.files || []) : [];
    const showError = (message) => {
      if (!(error instanceof HTMLElement)) return;
      error.textContent = message;
      error.hidden = false;
    };
    const clearError = () => {
      if (error instanceof HTMLElement) {
        error.textContent = "";
        error.hidden = true;
      }
    };
    const updatePhotoList = () => {
      if (!(photoList instanceof HTMLElement) || !(photoEmpty instanceof HTMLElement)) return;
      const files = selectedFiles();
      photoList.innerHTML = "";
      photoEmpty.hidden = files.length > 0;
      files.forEach((file) => {
        const item = document.createElement("li");
        item.textContent = `${file.name} · ${Math.max(1, Math.round(file.size / 1024))} KB`;
        photoList.append(item);
      });
    };
    const updateApplicantType = () => {
      const company = application.querySelector('input[name="applicantType"]:checked')?.getAttribute("value") === "transport-company";
      if (companyInput instanceof HTMLInputElement) companyInput.required = company;
      companyField?.classList.toggle("is-required", company);
    };
    const setSending = (label) => {
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = Boolean(label);
        submit.textContent = label || defaultSubmitLabel;
      }
    };
    const readDataUrl = (blob) => new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ""));
      reader.onerror = () => reject(new Error("File read failed"));
      reader.readAsDataURL(blob);
    });
    const compressPhoto = async (file) => {
      const sourceUrl = URL.createObjectURL(file);
      try {
        const image = await new Promise((resolve, reject) => {
          const source = new Image();
          source.onload = () => resolve(source);
          source.onerror = () => reject(new Error("Image load failed"));
          source.src = sourceUrl;
        });
        const longestSide = Math.max(image.naturalWidth, image.naturalHeight) || 1;
        const scale = Math.min(1, 1600 / longestSide);
        const canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
        canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
        const context = canvas.getContext("2d");
        if (!context) throw new Error("Canvas unavailable");
        context.drawImage(image, 0, 0, canvas.width, canvas.height);
        const blob = await new Promise((resolve, reject) => canvas.toBlob((value) => value ? resolve(value) : reject(new Error("Image compression failed")), "image/jpeg", 0.8));
        const dataUrl = await readDataUrl(blob);
        const data = dataUrl.split(",")[1] || "";
        const baseName = (file.name || "vehicle-photo").replace(/\.[^.]+$/, "").replace(/[^a-z0-9_-]+/gi, "-").replace(/^-+|-+$/g, "") || "vehicle-photo";
        return { name: `${baseName}.jpg`, type: "image/jpeg", data };
      } finally {
        URL.revokeObjectURL(sourceUrl);
      }
    };

    application.querySelectorAll('input[name="applicantType"]').forEach((input) => input.addEventListener("change", updateApplicantType));
    photoInput?.addEventListener("change", () => { clearError(); updatePhotoList(); });
    application.querySelector("[data-partner-again]")?.addEventListener("click", () => {
      if (!(form instanceof HTMLFormElement)) return;
      form.reset();
      updateApplicantType();
      updatePhotoList();
      clearError();
      if (success instanceof HTMLElement) success.hidden = true;
      form.hidden = false;
    });
    updateApplicantType();
    updatePhotoList();

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
      clearError();
      const files = selectedFiles();
      if (!files.length) return showError(copy.photoRequired || "Please add at least one vehicle photo.");
      if (files.length > 3) return showError(copy.photoLimit || "Please add no more than three photos.");
      if (files.some((file) => file.size > 14 * 1024 * 1024)) return showError(copy.photoSize || "Each photo must be smaller than 14 MB.");
      try {
        setSending(copy.preparingPhotos || "Preparing photos...");
        const photos = await Promise.all(files.map(compressPhoto));
        const payloadSize = photos.reduce((total, photo) => total + Math.ceil(photo.data.length * 0.75), 0);
        if (payloadSize > 2700000) throw new Error("payload-too-large");
        const data = new FormData(form);
        const values = (name) => Array.from(form.querySelectorAll(`input[name="${name}"]:checked`)).map((input) => input.value);
        const value = (name) => String(data.get(name) || "");
        setSending(copy.sending || "Sending application...");
        const response = await fetch("/api/partner-application", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            language: value("language"), applicantType: value("applicantType"), fullName: value("fullName"), companyName: value("companyName"), email: value("email"), phone: value("phone"), country: value("country"), baseCity: value("baseCity"), yearsExperience: value("yearsExperience"), licenseNumber: value("licenseNumber"), transportPermit: value("transportPermit"), insuranceValidUntil: value("insuranceValidUntil"), languages: values("languages"), otherLanguages: value("otherLanguages"), availability: values("availability"), vehicleMake: value("vehicleMake"), vehicleModel: value("vehicleModel"), vehicleYear: value("vehicleYear"), plateNumber: value("plateNumber"), vehicleColor: value("vehicleColor"), vehicleType: value("vehicleType"), seats: value("seats"), luggageCapacity: value("luggageCapacity"), amenities: values("amenities"), serviceBase: value("serviceBase"), coverageCountries: value("coverageCountries"), usualRoutes: value("usualRoutes"), notes: value("notes"), agreement: data.get("agreement") === "on", photos,
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || "request-failed");
        form.hidden = true;
        if (reference instanceof HTMLElement && result.reference) {
          reference.querySelector("b").textContent = result.reference;
          reference.hidden = false;
        }
        if (success instanceof HTMLElement) success.hidden = false;
      } catch (_) {
        showError(copy.uploadError && _.message === "payload-too-large" ? copy.uploadError : copy.genericError || "Your application could not be sent right now. Please try again.");
      } finally {
        setSending("");
      }
    });
  }
</script>
