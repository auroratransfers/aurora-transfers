---
import { ArrowRight, CalendarCheck, Car, Check, Clock3, Compass, MapPin, Plane, Route, ShieldCheck, Ship, Sparkles } from "@lucide/astro";
import TransferBookingForm from "./TransferBookingForm.astro";
import { getContent, getInterfaceContent, type Lang } from "../data/site";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getContent(lang);
const ui = getInterfaceContent(lang);
const pillarIcons = [Plane, Route, Ship, Compass];
---

<section class="hero-grid grid-dots">
  <div class="hero-copy">
    <span class="section-marker"><Sparkles size={15} />{t.hero.badge}</span>
    <h1>{t.hero.title}</h1>
    <p class="hero-statement">{t.hero.statement}</p>
    <p>{t.hero.text}</p>
    <div class="button-row">
      <a class="pill-button primary" href="#hero-booking"><CalendarCheck size={17} />{t.hero.primary}</a>
      <a class="pill-button outline" href={`/${lang}/destinations/`}><Compass size={17} />{t.hero.secondary}</a>
    </div>
    <div class="hero-trust"><span><ShieldCheck size={17} />{ui.licensedDrivers}</span><span><Clock3 size={17} />{ui.available247}</span></div>
  </div>
  <TransferBookingForm lang={lang} variant="hero" />
</section>

<section class="intro-section intro-with-image section-rule">
  <div class="image-card">
    <img src="/media/dubrovnik-harbor.jpg" alt={ui.imageAltHarbor} loading="lazy" />
    <div class="image-caption"><div><strong>Aurora Private Transfers</strong><span>{ui.imageCaption}</span></div><span class="location-pill"><MapPin size={14} /> Dubrovnik</span></div>
    <div class="stats-grid">
      <div><strong>10k+</strong><span>{t.stats[0]}</span></div><div><strong>50+</strong><span>{t.stats[1]}</span></div><div><strong>10+</strong><span>{t.stats[2]}</span></div>
    </div>
  </div>
  <div class="intro-content">
    <span class="section-marker kiwi-marker">{t.welcome.tag}</span>
    <h2>{t.welcome.title}</h2>
    <div class="intro-copy"><p>{t.welcome.p1}</p><p>{t.welcome.p2}</p></div>
    <a class="pill-button primary" href={`/${lang}/about/`}>{t.nav.about}<ArrowRight size={16} /></a>
  </div>
</section>

<section class="section-block section-rule">
  <div class="section-heading"><div><span class="section-marker pink-marker">{t.pillars.tag}</span><h2>{t.pillars.title}</h2></div><p>{t.pillars.text}</p></div>
  <div class="pillar-grid">
    {t.pillars.items.map((item, index) => { const Icon = pillarIcons[index]; return <a class="pillar-card" href={`/${lang}/services/`}><Icon size={25} /><h3>{item[0]}</h3><p>{item[1]}</p><span>{t.nav.services}<ArrowRight size={14} /></span></a>; })}
  </div>
</section>

<section class="feature-section section-rule">
  <div class="feature-panel pink-grid">
    <span class="section-marker light-marker">{t.why.tag}</span>
    <h2>{t.why.title}</h2>
    <p>{t.why.text}</p>
    <ul>{t.why.points.map((point) => <li><span><Check size={16} /></span>{point}</li>)}</ul>
    <a class="pill-button light" href={`/${lang}/book/`}>{t.hero.primary}<ArrowRight size={16} /></a>
  </div>
  <div class="feature-photo">
    <img src="/media/dubrovnik-harbor.jpg" alt={ui.imageAltTransfer} loading="lazy" />
    <div class="photo-note"><Car size={22} /><div><strong>{ui.doorToDoor}</strong><span>{ui.serviceTypes}</span></div></div>
  </div>
</section>

<section class="section-block section-rule">
  <div class="section-heading"><div><span class="section-marker kiwi-marker">{t.route.tag}</span><h2>{t.route.title}</h2></div><a class="text-link" href={`/${lang}/destinations/`}>{t.route.cta}<ArrowRight size={15} /></a></div>
  <div class="route-grid">
    <article><span>01</span><div><h3>{ui.destinationCards[0][0]} · {lang === "hr" ? "Stari grad" : lang === "de" ? "Altstadt" : lang === "fr" ? "Vieille ville" : "Old Town"}</h3><p>{ui.routes[0]}</p></div><Plane size={22} /></article>
    <article><span>02</span><div><h3>Dubrovnik · Kotor</h3><p>{ui.routes[1]}</p></div><Route size={22} /></article>
    <article><span>03</span><div><h3>Dubrovnik · Mostar</h3><p>{ui.routes[2]}</p></div><Route size={22} /></article>
    <article><span>04</span><div><h3>Dubrovnik · Split</h3><p>{ui.routes[3]}</p></div><Car size={22} /></article>
  </div>
</section>

<section class="final-cta purple-grid">
  <div><span class="section-marker light-marker">Aurora Transfers</span><h2>{t.cta.title}</h2><p>{t.cta.text}</p></div>
  <a class="pill-button kiwi" href={`/${lang}/book/`}>{t.cta.button}<ArrowRight size={17} /></a>
</section>
