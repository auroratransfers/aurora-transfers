---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePage from "../../components/HomePage.astro";
import { languages, getLabels, type Lang } from "../../data/site";
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = getLabels(lang);
---
<BaseLayout lang={lang} active="home" title={`Feniks Dubrovnik Transfers | ${t.hero.badge}`} description={t.hero.text}>
  <HomePage lang={lang} />
</BaseLayout>
