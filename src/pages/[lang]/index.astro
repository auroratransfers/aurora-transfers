---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePage from "../../components/HomePage.astro";
import { getContent, languages, type Lang } from "../../data/site";
export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = getContent(lang);
---
<BaseLayout lang={lang} active="home" title={`Feniks Dubrovnik Transfers | ${t.hero.title}`} description={t.hero.text}><HomePage lang={lang} /></BaseLayout>
