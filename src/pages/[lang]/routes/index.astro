---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RouteIndexPage from "../../../components/RouteIndexPage.astro";
import { languages, type Lang } from "../../../data/site";
import { getRouteCopy } from "../../../data/routes";

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const content = getRouteCopy(lang);
---

<BaseLayout lang={lang} active="routes" title={`${content.indexTitle} | Aurora Private Transfers`} description={content.indexIntro}><RouteIndexPage lang={lang} /></BaseLayout>
